{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "interactive": true,
      "persistent": true,
      "outputLogs": "new-only"
    },
    "clean": {
      "cache": false
    },
    "cf-typegen": {
      "dependsOn": ["clean"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["clean", "^check"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "lint": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "build:development": {
      "dependsOn": ["^build:development"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".svelte-kit/**", "build/**", "dist/**"]
    },
    "build:staging": {
      "dependsOn": ["clean", "cf-typegen", "check", "lint", "^build:staging"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*", "src/workerConfiguration.d.ts"],
      "outputs": [".svelte-kit/**", "build/**"]
    },
    "build:production": {
      "dependsOn": ["clean", "cf-typegen", "check", "lint", "^build:production"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*", "src/workerConfiguration.d.ts"],
      "outputs": [".svelte-kit/**", "build/**"],
      "env": ["CF_ENV"]
    },
    "deploy:staging": {
      "cache": false,
      "dependsOn": ["build:staging"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "deploy:production": {
      "cache": false,
      "dependsOn": ["build:production"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  }
}
