{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sf-web",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "preview_urls": true,
  "workers_dev": true,
  "env": {
    "production": {
      "name": "sf-web-production",
      "routes": [
        {
          "pattern": "app.yourdomain.com",
          "custom_domain": true
        }
      ],
      "workers_dev": false,
      "preview_urls": false
    },
    "staging": {
      "name": "sf-web-staging"
    },
    "development": {
      "name": "sf-web-development"
    }
  }
}
