{
  "name": "@repo/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc --noEmit -p tsconfig.json",
    "generate:auth": "auth generate --config auth.config.ts --output src/db/auth-schema.ts --yes && oxfmt src/db/auth-schema.ts",
    "generate:db": "drizzle-kit generate --config drizzle.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/stripe": "1.7.5",
    "@hono/zod-validator": "0.9.1",
    "@paralleldrive/cuid2": "3.3.0",
    "better-auth": "1.7.5",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "hono": "4.13.9",
    "mimetext": "3.0.28",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.2",
    "auth": "1.7.5",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
