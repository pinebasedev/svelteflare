{
  "name": "@repo/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "CLOUDFLARE_ENV=development vite dev",
    "preview": "CLOUDFLARE_ENV=development vite build && vite preview",
    "build:development": "CLOUDFLARE_ENV=development vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "check": "tsc --noEmit -p tsconfig.json",
    "cf-typegen": "wrangler types src/workerConfiguration.d.ts",
    "lint": "prettier --check . && eslint .",
    "format": "NODE_OPTIONS=\"--experimental-strip-types\" prettier --write .",
    "generate:auth": "auth generate --config auth.config.ts --output src/db/auth-schema.ts --yes && prettier --write src/db/auth-schema.ts",
    "generate:db": "drizzle-kit generate --config drizzle.config.ts",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:staging": "pnpm run build:staging && wrangler deploy",
    "deploy:production": "pnpm run build:production && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/stripe": "1.7.5",
    "@hono/zod-validator": "0.9.1",
    "@paralleldrive/cuid2": "3.3.0",
    "better-auth": "1.7.5",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "hono": "4.13.9",
    "mimetext": "3.0.28",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.43.0",
    "@cloudflare/vitest-pool-workers": "0.18.0",
    "@cloudflare/workers-types": "5.20260707.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.1.0",
    "auth": "1.7.5",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "eslint": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.10",
    "wrangler": "4.107.0"
  },
  "packageManager": "pnpm@10.26.0"
}
