{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "name": "sf-api",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "preview_urls": true,
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sf-db-local",
      "database_id": "<YOUR_D1_DATABASE_ID>"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "FREE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "PREMIUM_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_API_URL": "http://localhost:9003",
    "PUBLIC_BETTER_AUTH_URL": "http://localhost:9003",
    "PUBLIC_ORIGIN_ALLOWLIST": "http://localhost:9002",
    "PUBLIC_GOOGLE_CLIENT_ID": "",
    "EMAIL_FROM_ADDRESS": "hello@example.com",
    "EMAIL_FROM_NAME": "Demo App"
  },
  "env": {
    "production": {
      "name": "sf-api-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "api.yourdomain.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sf-db-production",
          "database_id": "<YOUR_D1_DATABASE_ID_PRODUCTION>"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "ratelimits": [
        {
          "name": "FREE_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "PREMIUM_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ],
      "vars": {
        "PUBLIC_API_URL": "https://api.yourdomain.com",
        "PUBLIC_BETTER_AUTH_URL": "https://api.yourdomain.com",
        "PUBLIC_ORIGIN_ALLOWLIST": "https://app.yourdomain.com",
        "PUBLIC_GOOGLE_CLIENT_ID": "",
        "EMAIL_FROM_ADDRESS": "hello@example.com",
        "EMAIL_FROM_NAME": "Demo App"
      }
    },
    "staging": {
      "name": "sf-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sf-db-staging",
          "database_id": "<YOUR_D1_DATABASE_ID_STAGING>"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "vars": {
        "PUBLIC_API_URL": "https://sf-api-staging.<YOUR_SUBDOMAIN>.workers.dev",
        "PUBLIC_BETTER_AUTH_URL": "https://sf-api-staging.<YOUR_SUBDOMAIN>.workers.dev",
        "PUBLIC_ORIGIN_ALLOWLIST": "https://sf-web-staging.<YOUR_SUBDOMAIN>.workers.dev",
        "PUBLIC_GOOGLE_CLIENT_ID": "",
        "EMAIL_FROM_ADDRESS": "hello@example.com",
        "EMAIL_FROM_NAME": "Demo App"
      }
    },
    "development": {
      "name": "sf-api-development",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sf-db-local",
          "database_id": "<YOUR_D1_DATABASE_ID>"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "ratelimits": [
        {
          "name": "FREE_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "PREMIUM_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ],
      "vars": {
        "PUBLIC_API_URL": "http://localhost:9003",
        "PUBLIC_BETTER_AUTH_URL": "http://localhost:9003",
        "PUBLIC_ORIGIN_ALLOWLIST": "http://localhost:9002",
        "PUBLIC_GOOGLE_CLIENT_ID": "",
        "EMAIL_FROM_ADDRESS": "hello@example.com",
        "EMAIL_FROM_NAME": "Demo App"
      }
    }
  }
}
