# Read by the Alchemy stack (alchemy.run.ts) for `pnpm dev`, `pnpm deploy`,
# and `pnpm bootstrap:github`. Copy to `.env`. In CI the same names come from
# GitHub Actions secrets and variables. `pnpm dev` runs without this file.

# API secrets. BETTER_AUTH_SECRET is required on every deployed stage
# (`openssl rand -base64 32`); the rest turn their feature off when empty.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
# Local only: the signing secret `stripe listen` prints. Deployed stages get
# theirs from the webhook endpoint Alchemy registers (alchemy/Stripe.ts).
STRIPE_WEBHOOK_SECRET=

# Public config (optional).
PUBLIC_GOOGLE_CLIENT_ID=
# Sender for verification and password-reset emails, on a domain onboarded to
# Cloudflare Email Service. Unset on a deployed stage: emails are skipped (logged).
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Deploys to workers.dev: the account's workers.dev subdomain
# (dashboard: Workers & Pages -> Settings -> Subdomain). Required.
CLOUDFLARE_WORKERS_SUBDOMAIN=

# Access gate on pr-* and staging (alchemy/Access.ts). Required for those stages.
# Comma-separated emails allowed to log in, the Zero Trust Google IdP id, and the
# Zero Trust team name (<team>.cloudflareaccess.com).
CF_ACCESS_ALLOW_EMAIL=
CF_GOOGLE_IDP_ID=
CF_ACCESS_TEAM_DOMAIN=

# prod custom domains (optional; the zone must be on this account). API and app
# go together; marketing is independent.
PROD_API_DOMAIN=
PROD_APP_DOMAIN=
PROD_MARKETING_DOMAIN=

# Deploys only: the key Alchemy registers each stage's Stripe webhook endpoint
# with (alchemy/Stripe.ts). Unset: no endpoint is registered. For prod, a
# live-mode restricted key that can only write webhook endpoints.
STRIPE_API_KEY=

# `pnpm bootstrap:github` only (alchemy/github.ts).
CLOUDFLARE_ACCOUNT_ID=
GITHUB_REPO=
# The project's name in project-ops; defaults to GITHUB_REPO's repo half.
PROJECT_NAME=
# project-ops' D1 database; defaults to production-project-ops-db.
CONTROL_PLANE_DB=
