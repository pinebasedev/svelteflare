{
  "name": "svelteflare",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "build": "turbo run build",
    "lint": "turbo run lint && oxlint alchemy alchemy.run.ts scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "turbo run check && pnpm run check:alchemy",
    "check:alchemy": "tsc -p tsconfig.alchemy.json && node --test alchemy/ciTokenPolicies.test.mjs scripts/bootstrap-github.test.mjs",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "bootstrap:github": "node scripts/bootstrap-github.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.6.2",
    "husky": "9.1.7",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "2.11.3",
    "typescript": "6.0.3",
    "wrangler": "4.136.3"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.117"
  }
}
